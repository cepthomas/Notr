{
    "notr_index": "~/.config/sublime-text/Packages/Notr/example/my-index-nx.ntr",
    "notr_paths":
    [
        "~/.config/sublime-text/Packages/Notr/example"
    ],
    "section_sel_depth": 2,
    "fixed_hl":
    [
        ["2DO", "and_a"],
        ["user", "and_b"],
        ["dynamic", "and_c"]
    ],
    "sticky":
    [
        "notr-spec#section no tags",
        "my-index#Other Files of Interest"
    ]
}
